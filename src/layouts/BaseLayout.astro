---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE, withBase } from '../lib/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	lang?: 'ko' | 'en';
	canonicalPath?: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	type?: 'website' | 'article';
	pageClass?: string;
	alternatePath?: string;
	schema?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	lang = 'ko',
	canonicalPath = '/',
	image = '/assets/brand/og-default.png',
	imageAlt = lang === 'ko' ? '바이너리테크 스튜디오 브랜드 이미지' : 'Binarytech studio brand image',
	imageWidth = 1200,
	imageHeight = 630,
	type = 'website',
	pageClass = '',
	alternatePath,
	schema,
	noindex = false,
} = Astro.props;

const documentTitle = title
	? `${title} | ${lang === 'ko' ? SITE.nameKo : SITE.nameEn}`
	: lang === 'ko'
		? `${SITE.nameKo} | 게임과 앱을 만드는 독립 개발 스튜디오`
		: `${SITE.nameEn} | Independent game and app studio`;
const origin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(withBase(canonicalPath), origin);
const imageUrl = new URL(withBase(image), origin);
const alternateUrl = alternatePath
	? new URL(withBase(alternatePath), origin)
	: null;
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE.nameKo,
	alternateName: SITE.nameEn,
	url: new URL(withBase('/'), origin).toString(),
	description: SITE.description,
};
const structuredData = [organizationSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
		<meta name="theme-color" content="#0b1c26" />
		<meta name="color-scheme" content="light" />
		<title>{documentTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href={withBase('/assets/brand/brand-mark.svg')} />
		<link rel="icon" type="image/png" sizes="512x512" href={withBase('/assets/brand/favicon.png')} />
		<link rel="apple-touch-icon" href={withBase('/assets/brand/apple-touch-icon.png')} />
		<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
		{alternateUrl && (
			<>
				<link rel="alternate" hreflang={lang === 'ko' ? 'en' : 'ko'} href={alternateUrl} />
				<link rel="alternate" hreflang="x-default" href={lang === 'ko' ? canonicalUrl : alternateUrl} />
			</>
		)}
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE.nameKo} />
		<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{structuredData.map((item) => (
			<script type="application/ld+json" set:html={JSON.stringify(item)} is:inline></script>
		))}
	</head>
	<body class={pageClass}>
		<a class="skip-link" href="#main-content">{lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
		<SiteHeader lang={lang} />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<SiteFooter lang={lang} />
	</body>
</html>
