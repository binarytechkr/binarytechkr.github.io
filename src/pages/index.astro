---
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { dantaProduct } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout alternatePath="/en/">
	<section class="company-hero">
		<div class="hero-grid shell">
			<div class="hero-copy">
				<p class="eyebrow">BINARYTECH · INDEPENDENT STUDIO</p>
				<h1>
					<span class="hero-line">작은 팀의 속도로,</span>
					<span class="hero-line"><span class="accent">오래 다듬을 제품</span>을</span>
					<span class="hero-line">만듭니다.</span>
				</h1>
				<p>바이너리테크는 게임과 앱을 직접 기획·개발·운영하는 1인 개발 스튜디오입니다. 지금은 첫 번째 게임 <strong>천하제일 단타대회</strong>를 준비하고 있습니다.</p>
				<div class="button-row">
					<a class="button button-on-dark" href={withBase('/products/danta/')}>대표 제품 보기 <span aria-hidden="true">→</span></a>
					<a class="button button-ghost-dark" href={withBase('/about/')}>스튜디오 소개</a>
				</div>
			</div>
			<div class="studio-console" role="group" aria-label="바이너리테크의 개발 흐름">
				<div class="console-head"><span>BINARY / BUILD LOG</span><span>01</span></div>
				<div class="console-signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
				<ol>
					<li><span>01</span><strong>BUILD</strong><small>직접 만들기</small></li>
					<li><span>10</span><strong>VERIFY</strong><small>사실로 확인하기</small></li>
					<li><span>11</span><strong>RELEASE</strong><small>준비된 범위만 공개하기</small></li>
					<li><span>100</span><strong>IMPROVE</strong><small>출시 뒤에도 다듬기</small></li>
				</ol>
				<p>ONE PERSON · CLEAR OWNERSHIP</p>
			</div>
		</div>
	</section>

	<section class="content-section surface-section" aria-labelledby="featured-product">
		<div class="shell">
			<SectionHeading id="featured-product" eyebrow="Featured product" title="첫 번째 제품, 실제로 준비 중인 한 가지" description="존재하지 않는 제품이나 출시 일정을 앞세우지 않습니다. 현재 확인 가능한 대표 제품과 상태만 보여 드립니다." />
			<div class="featured-grid">
				<ProductCard product={dantaProduct} />
				<div class="product-preview">
					<img src={withBase('/assets/products/danta/feature-graphic.png')} width="1024" height="500" alt="천하제일 단타대회 가상 시세 게임 대표 이미지" />
					<div class="preview-copy">
						<p class="eyebrow">Virtual market game</p>
						<h3>가상 시장을 읽고,<br />5분 안에 승부하다.</h3>
						<ul class="fact-list">
							<li>7개 가상 종목</li>
							<li>5분 단타 · 1분 번개단타</li>
							<li>결과 카드와 도전 코드 공유</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="content-section" aria-labelledby="product-hub-heading">
		<div class="shell">
			<SectionHeading id="product-hub-heading" eyebrow="Product hub" title="한 제품씩, 같은 기준으로 쌓이는 허브" description="출시·출시 준비 중·개발 중 상태를 구분하고, 각 제품의 소개·지원·정책 문서를 같은 구조로 관리합니다." />
			<div class="hub-grid">
				<a class="hub-slot active" href={withBase('/products/danta/')}>
					<span>01</span><div><strong>천하제일 단타대회</strong><small>출시 준비 중 · 대표 제품</small></div><b aria-hidden="true">→</b>
				</a>
				<div class="hub-slot future">
					<span>10</span><div><strong>다음 제품을 위한 자리</strong><small>실제 공개 범위가 정해진 뒤 추가합니다.</small></div>
				</div>
			</div>
			<p class="hub-link"><a class="text-link" href={withBase('/products/')}>제품 허브 전체 보기 <span aria-hidden="true">→</span></a></p>
		</div>
	</section>

	<section class="content-section surface-section" aria-labelledby="principles-heading">
		<div class="shell">
			<SectionHeading id="principles-heading" eyebrow="How we build" title="바이너리테크가 제품을 만드는 기준" description="1인 스튜디오의 규모를 감추지 않고, 검증할 수 있는 범위와 사용자에게 보이는 책임을 분명하게 둡니다." />
			<div class="card-grid">
				<article class="info-card"><span class="number">01</span><h3>작게 시작하고 오래 개선하기</h3><p>한 번에 많은 약속을 하기보다 실행 가능한 제품을 만들고, 확인된 피드백을 다음 개선으로 연결합니다.</p></article>
				<article class="info-card"><span class="number">10</span><h3>기능보다 사실을 먼저 말하기</h3><p>도입하지 않은 계정·광고·분석 기능이나 확정되지 않은 출시 일정을 공개 문구로 만들지 않습니다.</p></article>
				<article class="info-card"><span class="number">11</span><h3>읽기 쉽고 접근 가능한 기본</h3><p>작은 화면, 큰 글자, 키보드 탐색, 동작 줄이기와 자연스러운 한국어·영어 경험을 함께 점검합니다.</p></article>
			</div>
		</div>
	</section>

	<section class="home-contact">
		<div class="home-contact-inner shell">
			<div><p class="eyebrow">Support &amp; studio</p><h2>제품 정보부터 지원 문서까지,<br />한곳에서 확인하세요.</h2></div>
			<div class="button-row"><a class="button button-on-dark" href={withBase('/support/')}>고객지원·FAQ</a><a class="button button-ghost-dark" href={withBase('/about/')}>회사 소개</a></div>
		</div>
	</section>
</BaseLayout>

<style>
	.company-hero { position: relative; overflow: hidden; padding-block: clamp(5.5rem, 10vw, 9rem); background: #0b1c26; color: white; }
	.company-hero::before { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px); background-size: 4.5rem 4.5rem; mask-image: linear-gradient(90deg, black, transparent 78%); content: ""; }
	.company-hero::after { position: absolute; top: -13rem; right: -10rem; width: 34rem; height: 34rem; border: 1px solid rgb(50 199 239 / 35%); border-radius: 50%; box-shadow: 0 0 0 5rem rgb(50 199 239 / 3%), 0 0 0 10rem rgb(255 91 115 / 2%); content: ""; }
	.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(22rem, .8fr); gap: clamp(3rem, 8vw, 7rem); align-items: center; }
	.hero-copy h1 { max-width: 52rem; margin-bottom: 1.75rem; font-size: clamp(2.35rem, 5vw, 4.65rem); }
	.hero-copy h1 .hero-line { display: block; white-space: nowrap; }
	.hero-copy h1 .accent { color: #68d7ca; }
	.hero-copy .eyebrow { color: #69d7ca; }
	.hero-copy > p:not(.eyebrow) { max-width: 43rem; margin-bottom: 2rem; color: #c2d0d2; font-size: clamp(1.05rem, 2vw, 1.25rem); }
	.hero-copy strong { color: white; }
	.studio-console { padding: 1.4rem; border: 1px solid rgb(255 255 255 / 16%); border-radius: 1.4rem; background: rgb(6 22 30 / 74%); box-shadow: 0 28px 80px rgb(0 0 0 / 30%); backdrop-filter: blur(10px); }
	.console-head { display: flex; justify-content: space-between; padding-bottom: .9rem; border-bottom: 1px solid rgb(255 255 255 / 12%); color: #8facb2; font-size: .7rem; font-weight: 800; letter-spacing: .13em; }
	.console-signal { display: grid; grid-template-columns: repeat(8, 1fr); gap: .32rem; height: 3.4rem; align-items: end; margin-block: 1.2rem; }
	.console-signal i { height: 24%; border-radius: .15rem .15rem 0 0; background: #32c7ef; }
	.console-signal i:nth-child(2) { height: 52%; } .console-signal i:nth-child(3) { height: 37%; background: #ff5b73; } .console-signal i:nth-child(4) { height: 76%; } .console-signal i:nth-child(5) { height: 58%; } .console-signal i:nth-child(6) { height: 88%; background: #ff5b73; } .console-signal i:nth-child(7) { height: 68%; } .console-signal i:nth-child(8) { height: 100%; background: white; }
	.studio-console ol { display: grid; gap: .55rem; margin: 0; padding: 0; list-style: none; }
	.studio-console li { display: grid; grid-template-columns: 2.7rem 1fr auto; gap: .7rem; align-items: center; padding: .75rem .8rem; border: 1px solid rgb(255 255 255 / 9%); border-radius: .7rem; }
	.studio-console li span { color: #6bd9cc; font-size: .7rem; font-weight: 800; letter-spacing: .12em; }
	.studio-console li strong { font-size: .84rem; letter-spacing: .07em; }
	.studio-console li small { color: #8fa3a7; }
	.studio-console > p { margin: 1rem 0 0; color: #789196; font-size: .67rem; font-weight: 800; letter-spacing: .14em; text-align: right; }
	.featured-grid { display: grid; grid-template-columns: minmax(20rem, .8fr) minmax(0, 1.2fr); gap: 1.5rem; align-items: stretch; }
	.product-preview { overflow: hidden; border-radius: 1.5rem; background: #071721; color: white; box-shadow: 0 8px 30px rgb(9 28 38 / 8%); }
	.product-preview img { width: 100%; aspect-ratio: 1024 / 500; object-fit: cover; }
	.preview-copy { padding: clamp(1.4rem, 4vw, 2.4rem); }
	.preview-copy .eyebrow { color: #54d3f3; }
	.preview-copy h3 { margin-bottom: 1.5rem; font-size: clamp(1.8rem, 4vw, 2.8rem); }
	.preview-copy .fact-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
	.preview-copy .fact-list li { padding: .75rem .75rem .75rem 2rem; border: 1px solid rgb(255 255 255 / 12%); border-radius: .7rem; color: #c6d4d6; font-size: .83rem; }
	.preview-copy .fact-list li::before { left: .8rem; background: #32c7ef; }
	.hub-grid { display: grid; gap: .8rem; }
	.hub-slot { display: grid; min-height: 6rem; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; padding: 1rem 1.2rem; border: 1px solid #ced9d4; border-radius: 1rem; background: white; text-decoration: none; }
	.hub-slot > span { color: #0f6e65; font-size: .78rem; font-weight: 800; letter-spacing: .1em; }
	.hub-slot div { display: grid; gap: .25rem; }
	.hub-slot small { color: #52656b; }
	.hub-slot b { color: #0f6e65; font-size: 1.25rem; }
	.hub-slot.active:hover { border-color: #1b8f82; box-shadow: 0 8px 30px rgb(9 28 38 / 8%); }
	.hub-slot.future { border-style: dashed; background: transparent; color: #52656b; }
	.hub-link { margin: 1.4rem 0 0; text-align: right; }
	.home-contact { padding-block: clamp(4.5rem, 8vw, 7rem); background: #12313c; color: white; }
	.home-contact-inner { display: flex; justify-content: space-between; gap: 2rem; align-items: end; }
	.home-contact .eyebrow { color: #69d7ca; }
	.home-contact h2 { margin-bottom: 0; font-size: clamp(2rem, 4vw, 3.25rem); }
	@media (max-width: 900px) { .hero-grid, .featured-grid { grid-template-columns: 1fr; } .studio-console { max-width: 36rem; } .preview-copy .fact-list { grid-template-columns: 1fr; } .home-contact-inner { align-items: flex-start; flex-direction: column; } }
	@media (max-width: 560px) { .company-hero { padding-block: 4.5rem; } .hero-grid { gap: 2.5rem; } .studio-console { padding: 1rem; } .studio-console li { grid-template-columns: 2.1rem 1fr; } .studio-console li small { grid-column: 2; } .featured-grid { display: block; } .featured-grid :global(.product-card) { margin-bottom: 1rem; } .hub-slot { grid-template-columns: 2.2rem 1fr; } .hub-slot b { display: none; } }
</style>
