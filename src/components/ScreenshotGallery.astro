---
import { withBase } from '../lib/site';

interface Screenshot {
	src: string;
	alt: string;
	caption: string;
}

interface Props {
	screenshots: readonly Screenshot[];
}

const { screenshots } = Astro.props;
---

<div class="screenshot-gallery" role="group" aria-label="실제 앱 화면 모음">
	<ul tabindex="0" aria-label="앱 화면 스크린샷 목록. 작은 화면에서는 좌우 방향키로 이동할 수 있습니다.">
		{screenshots.map((screenshot) => (
			<li>
				<figure>
					<img src={withBase(screenshot.src)} width="1080" height="1920" alt={screenshot.alt} loading="lazy" decoding="async" />
					<figcaption>{screenshot.caption}</figcaption>
				</figure>
			</li>
		))}
	</ul>
	<p class="gallery-note">저장소의 실제 개발 빌드로 만든 화면입니다. 출시 전 UI와 문구는 달라질 수 있습니다.</p>
</div>
