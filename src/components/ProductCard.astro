---
import type { ProductStatus } from '../data/products';
import { withBase } from '../lib/site';
import StatusPill from './StatusPill.astro';

interface Props {
	product: {
		name: string;
		nameEn: string;
		summary: string;
		status: ProductStatus;
		icon: string;
		platformNote: string;
	};
}

const { product } = Astro.props;
---

<article class="product-card">
	<div class="product-card-top">
		<img src={withBase(product.icon)} width="512" height="512" alt={`${product.name} 앱 아이콘`} loading="lazy" />
		<div>
			<StatusPill status={product.status} />
			<p class="product-kicker">대표 제품</p>
		</div>
	</div>
	<div class="product-card-copy">
		<h3>{product.name}</h3>
		<p class="product-en" lang="en">{product.nameEn}</p>
		<p>{product.summary}</p>
	</div>
	<div class="product-card-meta">
		<span>{product.platformNote}</span>
		<a class="text-link" href={withBase('/products/danta/')}>제품 자세히 보기 <span aria-hidden="true">→</span></a>
	</div>
</article>
